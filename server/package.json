{
  "name": "ecom-server",
  "version": "1.0.0",
  "description": "Cholbe e-commerce API — NestJS + Prisma + PostgreSQL",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:import-medicines": "tsx scripts/import-medicines.ts",
    "db:pack-images": "tsx scripts/generate-pack-images.ts",
    "db:import-beauty": "tsx scripts/import-beauty.ts",
    "db:import-food": "tsx scripts/import-food.ts",
    "db:import-devices": "tsx scripts/import-devices.ts",
    "db:mirror-images": "tsx scripts/mirror-open-images.ts",
    "db:rasterize-packs": "tsx scripts/rasterize-pack-images.ts",
    "db:medicine-photos": "tsx scripts/apply-medicine-photos.ts",
    "db:enrich-lab": "tsx scripts/enrich-lab.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.19.3",
    "agora-token": "^2.0.5",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.43",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
